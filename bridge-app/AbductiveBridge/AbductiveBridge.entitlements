<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No sandbox: the app runs the reader's own `claude` binary with Process,
	     which the sandbox forbids. Hardened runtime stays on, with no JIT,
	     unsigned-memory or library-validation exceptions. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- The bridge listens on loopback. Outside the sandbox this entitlement
	     changes nothing; it records the one capability the app uses. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
